{
  "name": "gemguide-ai",
  "version": "1.0.0",
  "description": "Astrology-based gemstone recommendation platform",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "install-server": "npm install --prefix server",
    "install-client": "npm install --prefix client --legacy-peer-deps",
    "build-client": "npm run build --prefix client",
    "build": "npm run install-server && npm run install-client && npm run build-client",
    "start": "node server/server.js",
    "seed": "node server/utils/seedGemstones.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
